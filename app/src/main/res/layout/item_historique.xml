<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:backgroundTint="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Badge de statut (retard/présence) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/status_badge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            android:backgroundTint="#E8F5E9"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/status_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✅"
                android:textSize="24sp" />

        </androidx.cardview.widget.CardView>

        <!-- Contenu principal -->
        <LinearLayout
            android:id="@+id/content_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/status_badge"
            app:layout_constraintEnd_toStartOf="@+id/delete_icon">

            <TextView
                android:id="@+id/nom_surveillant_historique"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Surveillant"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#1A237E"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕐 "
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/heure_historique"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heure"
                    android:textSize="14sp"
                    android:textColor="#616161" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 "
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/salle_historique"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Salle"
                    android:textSize="13sp"
                    android:textColor="#757575" />

            </LinearLayout>

            <!-- Badge retard -->
            <androidx.cardview.widget.CardView
                android:id="@+id/retard_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:backgroundTint="#FFEBEE"
                android:visibility="gone">

                <TextView
                    android:id="@+id/retard_historique"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏰ Retard"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Bouton supprimer -->
        <androidx.cardview.widget.CardView
            android:id="@+id/delete_card"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            android:backgroundTint="#FFEBEE"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/delete_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_delete"
                android:contentDescription="Supprimer"
                android:tint="#D32F2F" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>